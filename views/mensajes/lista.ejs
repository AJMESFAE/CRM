<%- include('../partials/head') %>
<div class="cabecera"><div><h1>Mensajes</h1></div><a class="btn btn-primario" href="/mensajes/nuevo">+ Nuevo mensaje</a></div>
<nav class="pestanas">
  <a href="/mensajes" class="<%= carpeta === 'recibidos' ? 'activo' : '' %>">Recibidos<% if (noLeidos) { %> <span class="badge"><%= noLeidos %></span><% } %></a>
  <a href="/mensajes?carpeta=enviados" class="<%= carpeta === 'enviados' ? 'activo' : '' %>">Enviados</a>
</nav>
<section class="tarjeta">
  <% if (!mensajes.length) { %><p class="vacio">No hay mensajes.</p><% } else { %>
  <div class="tabla-wrap"><table>
    <thead><tr><th><%= carpeta === 'enviados' ? 'Para' : 'De' %></th><th>Asunto</th><th>Alumno</th><th>Fecha</th></tr></thead>
    <tbody><% mensajes.forEach(m => { %>
      <tr class="<%= carpeta === 'recibidos' && !m.leido ? 'no-leido' : '' %>">
        <td><%= m.otro_nombre %> <%= m.otro_apellidos %><br><small><%= h.ROLES[m.otro_rol] %></small></td>
        <td><a href="/mensajes/<%= m.id %>"><%= m.asunto %></a></td>
        <td><%= m.alumno_nombre ? m.alumno_nombre + ' ' + m.alumno_apellidos : '—' %></td>
        <td><small><%= h.fechaHora(m.creado_en) %></small></td>
      </tr>
    <% }) %></tbody>
  </table></div>
  <% } %>
</section>
<%- include('../partials/foot') %>
