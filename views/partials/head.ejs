<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · CRM Escolar</title>
  <link rel="icon" href="data:,">
  <link rel="stylesheet" href="/static/css/style.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body>
<% if (user) {
  const nav = {
    direccion: [
      ['/', 'Panel'], ['/alumnos', 'Alumnos'], ['/clases', 'Clases'],
      ['/usuarios?rol=profesor', 'Profesorado'], ['/usuarios?rol=tutor', 'Familias'],
      ['/asistencia', 'Asistencia'], ['/notas', 'Calificaciones'], ['/seguimiento', 'Seguimiento'],
      ['/informes', 'Informes'], ['/mensajes', 'Mensajes'],
    ],
    profesor: [
      ['/', 'Mi panel'], ['/clases', 'Mis clases'], ['/alumnos', 'Alumnos'], ['/asistencia', 'Pasar lista'],
      ['/notas', 'Calificaciones'], ['/seguimiento', 'Seguimiento'], ['/mensajes', 'Mensajes'],
    ],
    tutor: [['/', 'Mis hijos'], ['/mensajes', 'Mensajes']],
  }[user.rol];
  const activo = (href) => {
    const p = href.split('?')[0];
    return p === '/' ? ruta === '/' : ruta.startsWith(p);
  };
%>
<header class="topbar">
  <a class="marca" href="/"><span class="logo">◆</span> CRM Escolar</a>
  <nav class="menu">
    <% nav.forEach(([href, label]) => { %>
      <a href="<%= href %>" class="<%= activo(href) ? 'activo' : '' %>"><%= label %><% if (href === '/mensajes' && noLeidos) { %> <span class="badge"><%= noLeidos %></span><% } %></a>
    <% }) %>
  </nav>
  <div class="usuario">
    <a href="/perfil" title="Mi perfil"><strong><%= user.nombre %> <%= user.apellidos %></strong><small><%= h.ROLES[user.rol] %></small></a>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-link">Salir</button></form>
  </div>
</header>
<% } %>
<main class="contenido">
<% if (flash) { %>
  <div class="aviso aviso-<%= flash.tipo %>"><%= flash.mensaje %></div>
<% } %>
