# Variables de entorno del CRM. En local son opcionales; en Azure las define
# infra/deploy.sh como "App Settings" del App Service (ver docs/despliegue-azure.md).
# Node no lee este fichero solo: expórtelas o use `node --env-file=.env src/server.js`.

PORT=3000
# NODE_ENV=production exige SESSION_SECRET y ADMIN_PASSWORD (con la base de datos vacía)
NODE_ENV=development

# Base de datos SQLite. En Azure: /home/colegio/colegio.db con journal DELETE
DB_PATH=data/colegio.db
SQLITE_JOURNAL_MODE=WAL

# Copias de seguridad diarias (VACUUM INTO). En Azure: /home/colegio/backups
# BACKUP_DIR=data/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=14

# Secreto de las cookies de sesión (openssl rand -hex 32)
SESSION_SECRET=cambie-este-secreto

# Usuario principal de Dirección (solo se crea si la base de datos está vacía)
ADMIN_EMAIL=direccion@colegio.mezquitacentral.org
ADMIN_PASSWORD=cambie-esta-clave

# Detrás de un proxy HTTPS (Azure App Service = 1)
# TRUST_PROXY=1
# COOKIE_SECURE=1
